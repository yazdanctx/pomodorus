# Copy to .env for anything you want to override. The defaults in
# server/internal/config already point at the docker-compose stack, so local
# development needs none of this.

# development | production. Anything else is refused at boot.
ENV=development
ADDR=:8081
DATABASE_URL=postgres://pomodorus:pomodorus@localhost:5433/pomodorus?sslmode=disable

# Mailpit locally; Liara's email service in production. The same SMTP client
# runs in both, so what is tested here is what ships.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Pomodorus <no-reply@pomodorus.local>

# Set to 1 only when a proxy in front of the app sets X-Forwarded-For and
# X-Forwarded-Proto. Off by default because a header anyone can send is a
# header that defeats the per-host rate limit.
TRUST_PROXY_HEADERS=

# Every session collapses to a few seconds while still being recorded at its
# full nominal duration, so the bell, the ring, the break and the cycle are all
# testable in a minute. Server-side only, and refused outright when
# ENV=production: a client that could ask for this could mint focus time.
FAST_SESSIONS=

# Web Push (milestone 6). Generate with `make vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
