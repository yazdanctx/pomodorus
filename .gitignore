.DS_Store

# Node
node_modules/
*.log

# Build output
bin/
# The client is built into the Go binary's embed directory; the directory is
# tracked (embed needs it to exist) but its contents never are.
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep

# Env — every secret lives here and none of it is committed.
.env
.env.*
!.env.example

# Playwright
test-results/
playwright-report/

# TypeScript incremental build state
*.tsbuildinfo
